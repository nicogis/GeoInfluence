<UserControl x:Class="GeoInfluence.Pro.GeoInfluenceDockPaneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="720"
             d:DesignWidth="420">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="{Binding Heading}"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Margin="0,0,0,8" />

        <TextBlock Grid.Row="1"
                   Text="MVP 0.1 — Anisotropic Influence"
                   Margin="0,0,0,16" />

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <GroupBox Header="Input sites" Margin="0,0,0,10">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Point layer"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0" />

                        <ComboBox Grid.Column="1"
                                  MinWidth="170"
                                  ItemsSource="{Binding PointLayers}"
                                  SelectedItem="{Binding SelectedLayer, Mode=TwoWay}"
                                  DisplayMemberPath="Name" />

                        <Button Grid.Column="2"
                                Margin="8,0,0,0"
                                Padding="10,3"
                                Command="{Binding RefreshLayersCommand}">
                            Refresh
                        </Button>

                        <TextBlock Grid.Row="1"
                                   Grid.ColumnSpan="3"
                                   Margin="0,8,0,0"
                                   Text="If the layer has a selection, only selected points are loaded; otherwise the full layer is used."
                                   TextWrapping="Wrap"
                                   Opacity="0.75" />
                    </Grid>
                </GroupBox>

                <GroupBox Header="Field mapping" Margin="0,0,0,10">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="ID"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,8" />
                        <ComboBox Grid.Column="1"
                                  Margin="0,0,0,8"
                                  ItemsSource="{Binding AllFields}"
                                  SelectedItem="{Binding SelectedIdField, Mode=TwoWay}"
                                  DisplayMemberPath="DisplayName" />

                        <TextBlock Grid.Row="1"
                                   Text="Weight"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,8" />
                        <ComboBox Grid.Row="1"
                                  Grid.Column="1"
                                  Margin="0,0,0,8"
                                  ItemsSource="{Binding NumericFields}"
                                  SelectedItem="{Binding SelectedWeightField, Mode=TwoWay}"
                                  DisplayMemberPath="DisplayName" />

                        <TextBlock Grid.Row="2"
                                   Text="Bearing"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,8" />
                        <ComboBox Grid.Row="2"
                                  Grid.Column="1"
                                  Margin="0,0,0,8"
                                  ItemsSource="{Binding NumericFields}"
                                  SelectedItem="{Binding SelectedBearingField, Mode=TwoWay}"
                                  DisplayMemberPath="DisplayName" />

                        <TextBlock Grid.Row="3"
                                   Text="Major scale"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,8" />
                        <ComboBox Grid.Row="3"
                                  Grid.Column="1"
                                  Margin="0,0,0,8"
                                  ItemsSource="{Binding NumericFields}"
                                  SelectedItem="{Binding SelectedMajorScaleField, Mode=TwoWay}"
                                  DisplayMemberPath="DisplayName" />

                        <TextBlock Grid.Row="4"
                                   Text="Minor scale"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0" />
                        <ComboBox Grid.Row="4"
                                  Grid.Column="1"
                                  ItemsSource="{Binding NumericFields}"
                                  SelectedItem="{Binding SelectedMinorScaleField, Mode=TwoWay}"
                                  DisplayMemberPath="DisplayName" />
                    </Grid>
                </GroupBox>

                <GroupBox Header="Preview settings" Margin="0,0,0,10">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="90" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Resolution"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0" />

                        <TextBox Grid.Column="1"
                                 Text="{Binding PreviewResolution, UpdateSourceTrigger=PropertyChanged}"
                                 HorizontalContentAlignment="Right" />

                        <TextBlock Grid.Column="3"
                                   Text="Margin %"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0" />

                        <TextBox Grid.Column="4"
                                 Text="{Binding ExtentMarginPercent, UpdateSourceTrigger=PropertyChanged, StringFormat=F0}"
                                 HorizontalContentAlignment="Right" />

                        <CheckBox Grid.Row="1"
                                  Grid.ColumnSpan="5"
                                  Margin="0,8,0,0"
                                  Content="Confidence shading"
                                  IsChecked="{Binding ShowConfidence, Mode=TwoWay}"
                                  ToolTip="More opaque cells have a larger score margin over the second-best site." />
                    </Grid>
                </GroupBox>

                <GroupBox Header="Preview" Margin="0,0,0,10">
                    <WrapPanel Margin="8">
                        <Button Content="Load influence sites"
                                Command="{Binding LoadSitesCommand}"
                                IsEnabled="{Binding CanLoadSites}"
                                Padding="12,5"
                                Margin="0,0,8,8"
                                ToolTip="Load and validate the selected point sites." />

                        <Button Content="Calculate preview"
                                Command="{Binding CalculatePreviewCommand}"
                                IsEnabled="{Binding CanCalculatePreview}"
                                Padding="12,5"
                                Margin="0,0,8,8"
                                ToolTip="Calculate the allocation grid using the current preview settings." />

                        <Button Content="Clear preview"
                                Command="{Binding ClearPreviewCommand}"
                                IsEnabled="{Binding CanClearPreview}"
                                Padding="12,5"
                                Margin="0,0,8,8"
                                ToolTip="Remove the current preview overlay. The calculated allocation remains available for export." />
                    </WrapPanel>
                </GroupBox>

                <GroupBox Header="Output" Margin="0,0,0,10">
                    <WrapPanel Margin="8">
                        <Button Content="Export cells"
                                Command="{Binding ExportPolygonsCommand}"
                                IsEnabled="{Binding CanExport}"
                                Padding="12,5"
                                Margin="0,0,8,8"
                                ToolTip="Write the allocation grid cells to the project default geodatabase." />

                        <Button Content="Export regions"
                                Command="{Binding ExportRegionsCommand}"
                                IsEnabled="{Binding CanExport}"
                                Padding="12,5"
                                Margin="0,0,8,8"
                                ToolTip="Dissolve allocation cells by SiteId into influence regions." />

                        <Button Content="Export raster"
                                Command="{Binding ExportRasterCommand}"
                                IsEnabled="{Binding CanExport}"
                                Padding="12,5"
                                Margin="0,0,8,8"
                                ToolTip="Create an integer SiteId allocation raster in the project default geodatabase." />
                    </WrapPanel>
                </GroupBox>

                <TextBlock Text="{Binding LoadScope}"
                           Margin="0,0,0,8"
                           FontWeight="SemiBold" />

                <TextBlock Text="Preview output is temporary. Export cells writes the allocation grid; Export regions dissolves cells by SiteId; Export raster creates an integer allocation raster in the project default geodatabase."
                           Margin="0,0,0,8"
                           TextWrapping="Wrap"
                           Opacity="0.75" />

                <DataGrid ItemsSource="{Binding LoadedSites}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          HeadersVisibility="Column"
                          MinHeight="180"
                          MaxHeight="280">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="Auto" />
                        <DataGridTextColumn Header="X" Binding="{Binding X, StringFormat=F3}" Width="*" />
                        <DataGridTextColumn Header="Y" Binding="{Binding Y, StringFormat=F3}" Width="*" />
                        <DataGridTextColumn Header="Weight" Binding="{Binding Weight, StringFormat=F3}" Width="Auto" />
                        <DataGridTextColumn Header="Bearing" Binding="{Binding Anisotropy.BearingDegrees, StringFormat=F1}" Width="Auto" />
                        <DataGridTextColumn Header="Major" Binding="{Binding Anisotropy.MajorScale, StringFormat=F2}" Width="Auto" />
                        <DataGridTextColumn Header="Minor" Binding="{Binding Anisotropy.MinorScale, StringFormat=F2}" Width="Auto" />
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="3"
                Margin="0,12,0,0"
                Padding="10"
                BorderThickness="1.5"
                CornerRadius="4">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#FFF3F6FA" />
                    <Setter Property="BorderBrush" Value="#FF7A8A99" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding StatusLevel}" Value="Success">
                            <Setter Property="Background" Value="#FFEAF6EC" />
                            <Setter Property="BorderBrush" Value="#FF4C8C57" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding StatusLevel}" Value="Warning">
                            <Setter Property="Background" Value="#FFFFF4D6" />
                            <Setter Property="BorderBrush" Value="#FFB7791F" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding StatusLevel}" Value="Error">
                            <Setter Property="Background" Value="#FFFCE8E8" />
                            <Setter Property="BorderBrush" Value="#FFB23A3A" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="{Binding StatusIcon}"
                           FontSize="16"
                           FontWeight="Bold"
                           Margin="0,0,8,0"
                           VerticalAlignment="Top" />

                <TextBlock Grid.Column="1"
                           Text="{Binding Status}"
                           TextWrapping="Wrap" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
